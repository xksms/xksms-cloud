# XKSMS-Gateway 服务 Dockerfile
# 基于统一基础镜像构建

FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

# 复制父 POM
COPY pom.xml .
COPY xksms-dependencies/pom.xml xksms-dependencies/
COPY xksms-common/pom.xml xksms-common/
COPY xksms-starters/pom.xml xksms-starters/
COPY xksms-starters/*/pom.xml xksms-starters/
COPY xksms-gateway/pom.xml xksms-gateway/
COPY xksms-gateway/*/pom.xml xksms-gateway/

# 下载依赖
RUN mvn dependency:go-offline -B

# 复制源代码
COPY xksms-common/src xksms-common/src
COPY xksms-starters/*/src xksms-starters/
COPY xksms-gateway/*/src xksms-gateway/

# 构建 gateway 模块
RUN mvn clean package -DskipTests -B -pl xksms-gateway/xksms-gateway-core -am

# 运行阶段
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# 创建非 root 用户
RUN addgroup -S xksms && adduser -S xksms -G xksms

# 复制构建产物
COPY --from=builder /build/xksms-gateway/xksms-gateway-core/target/*.jar app.jar

# 设置时区
ENV TZ=Asia/Shanghai
RUN apk add --no-cache tzdata && cp /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

USER xksms:xksms

ENV JAVA_OPTS="-Xms512m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
