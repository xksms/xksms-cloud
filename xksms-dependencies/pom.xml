<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xksms</groupId>
    <artifactId>xksms-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>${project.artifactId}</name>
    <description>xksms-cloud 的依赖版本管理（JDK 21 / Boot 3.5.4 / Cloud 2025.0.0）</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>

        <!-- 平台对齐 -->
        <spring-boot.version>3.5.4</spring-boot.version>
        <spring.cloud.version>2025.0.0</spring.cloud.version>
        <spring.cloud.alibaba.version>2023.0.3.3</spring.cloud.alibaba.version>

        <!-- 插件版本 -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>


        <!-- 第三方组件版本 -->
        <lombok.version>1.18.34</lombok.version>
        <java-jwt.version>4.4.0</java-jwt.version>
        <sentinel.version>1.8.6</sentinel.version>
        <apm-agent-core.version>9.4.0</apm-agent-core.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <caffeine.version>3.1.8</caffeine.version>
        <micrometer.version>1.14.5</micrometer.version>

        <!-- 基础设施组件版本 -->
        <flyway-mysql.version>10.12.0</flyway-mysql.version>
        <jasypt-spring-boot.version>3.0.5</jasypt-spring-boot.version>

    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-bom</artifactId>
                <version>${micrometer.version}</version>
                <type>pom</type>
            </dependency>




            <!-- Caffeine 本地缓存 -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- Spring 依赖导入 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>


            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring.cloud.alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SkyWalking -->
            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-agent-core</artifactId>
                <version>${apm-agent-core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-toolkit-trace</artifactId>
                <version>${apm-agent-core.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-toolkit-webflux</artifactId>
                <version>${apm-agent-core.version}</version>
            </dependency>

            <!-- Sentinel -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-core</artifactId>
                <version>${sentinel.version}</version>
            </dependency>

            <!-- 日志增强 -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-toolkit-logback-1.x</artifactId>
                <version>${apm-agent-core.version}</version>
            </dependency>


            <!-- JWT -->
            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>${java-jwt.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- Spring 配置生成器 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring-boot.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- ==================== 基础设施组件 ==================== -->
            <!-- Flyway 数据库迁移工具 -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-mysql</artifactId>
                <version>${flyway-mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway-mysql.version}</version>
            </dependency>

            <!-- Jasypt 配置加密 -->
            <dependency>
                <groupId>com.github.ulisesbocchio</groupId>
                <artifactId>jasypt-spring-boot-starter</artifactId>
                <version>${jasypt-spring-boot.version}</version>
            </dependency>

            <!-- ==================== 内部模块 BOM ==================== -->
            <!-- 统一管理内部模块版本，避免硬编码 -->
            <!-- 注意：xksms-common 是聚合模块，不需要在此导入 -->
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-common-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-common-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-user-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-user-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-system-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-system-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-notify-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-notify-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-webflux</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-nacos</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-log</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-observability</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xksms</groupId>
                <artifactId>xksms-starter-rpc</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- MyBatis Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>3.5.6</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


</project>
