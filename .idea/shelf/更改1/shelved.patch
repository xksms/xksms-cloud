@@ -0,0 +1,40 @@
+package com.xksms.observability.observation;
+
+import io.micrometer.observation.Observation;
+import io.micrometer.observation.ObservationHandler;
+import org.apache.skywalking.apm.toolkit.trace.TraceContext;
+import org.slf4j.MDC;
+import org.springframework.core.Ordered;
+
+/**
+ * 将 traceId 注入 MDC，用于日志追踪
+ */
+public class MdcTraceObservationHandler implements ObservationHandler<Observation.Context>, Ordered {
+
+    private static final String TRACE_ID_KEY = "traceId";
+
+    @Override
+    public void onStart(Observation.Context context) {
+        // SkyWalking Agent 提供 traceId，若使用 OpenTelemetry 也可以通过 context 拿到
+        String traceId = TraceContext.traceId();
+
+        if (!traceId.isEmpty()) {
+            MDC.put(TRACE_ID_KEY, traceId);
+        }
+    }
+
+    @Override
+    public void onStop(Observation.Context context) {
+        MDC.remove(TRACE_ID_KEY);
+    }
+
+    @Override
+    public boolean supportsContext(Observation.Context context) {
+        return true; // 所有 Observation 都注入 traceId
+    }
+
+    @Override
+    public int getOrder() {
+        return LOWEST_PRECEDENCE; // 最后执行，确保已生成 trace
+    }
+}
