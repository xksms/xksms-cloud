+// 文件路径: xksms-starter-observability/src/main/java/com/xksms/observability/config/HttpServerRequestLoggingAutoConfiguration.java
+
+package com.xksms.observability.config;
+
+import com.xksms.observability.observation.ReactiveHttpServerRequestLoggingHandler;
+import com.xksms.observability.observation.ServletHttpServerRequestLoggingHandler;
+import io.micrometer.observation.ObservationRegistry;
+import org.springframework.boot.actuate.autoconfigure.observation.web.servlet.WebMvcObservationAutoConfiguration;
+import org.springframework.boot.autoconfigure.AutoConfiguration;
+import org.springframework.boot.autoconfigure.AutoConfigureAfter;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnBean;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingBean;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnWebApplication;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.annotation.Order;
+
+/**
+ * HTTP 请求日志处理器的自动配置。
+ * <p>
+ * 作用：
+ * 1. 当 classpath 中存在 ObservationRegistry 时，此配置生效。
+ * 2. 自动将我们的 HttpServerRequestLoggingHandler 注册为一个 Spring Bean。
+ * 3. Spring Boot 的 ObservationAutoConfiguration 会自动发现所有 ObservationHandler 类型的 Bean，
+ * 并将它们添加到全局的 ObservationRegistry 中。
+ */
+@AutoConfiguration
+@ConditionalOnBean(ObservationRegistry.class)
+@AutoConfigureAfter({ WebMvcObservationAutoConfiguration.class })
+public class HttpServerRequestLoggingAutoConfiguration {
+	// Slf4jMdcObservationHandler 的默认 Order 是 1000。
+	// 我们设置一个比它更小的值，来获得更高的执行优先级。
+	private static final int LOGGING_HANDLER_ORDER = 999;
+
+	@Configuration(proxyBeanMethods = false)
+	@ConditionalOnWebApplication(type = ConditionalOnWebApplication.Type.SERVLET)
+	static class ServletLoggingConfiguration {
+		@Bean
+		@Order(LOGGING_HANDLER_ORDER)
+		public ServletHttpServerRequestLoggingHandler servletHttpServerRequestLoggingHandler() {
+			return new ServletHttpServerRequestLoggingHandler();
+		}
+	}
+
+	@Configuration(proxyBeanMethods = false)
+	@ConditionalOnWebApplication(type = ConditionalOnWebApplication.Type.REACTIVE)
+	static class ReactiveLoggingConfiguration {
+		@Bean
+		@Order(LOGGING_HANDLER_ORDER)
+		public ReactiveHttpServerRequestLoggingHandler reactiveHttpServerRequestLoggingHandler() {
+			return new ReactiveHttpServerRequestLoggingHandler();
+		}
+	}
+}
