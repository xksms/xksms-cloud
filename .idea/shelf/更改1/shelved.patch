+package com.xksms.observability.observation;
+
+import io.micrometer.observation.Observation;
+import io.micrometer.observation.ObservationHandler;
+import jakarta.servlet.http.HttpServletResponse;
+import lombok.extern.slf4j.Slf4j;
+import org.apache.skywalking.apm.toolkit.trace.TraceContext;
+import org.slf4j.MDC;
+import org.springframework.http.server.observation.ServerRequestObservationContext;
+
+import java.util.concurrent.TimeUnit;
+
+@Slf4j
+public class ServletHttpServerRequestLoggingHandler implements ObservationHandler<ServerRequestObservationContext> {
+	@Override
+	public boolean supportsContext(Observation.Context context) {
+		return context instanceof ServerRequestObservationContext;
+	}
+
+	/**
+	 * 【关键修正】从 onStart 移动到 onScopeOpened。
+	 * 此时，MDC 已被 TracingObservationHandler 填充。
+	 */
+	@Override
+	public void onStart(ServerRequestObservationContext context) {
+		String traceId = TraceContext.traceId();
+		MDC.put("tid", traceId);
+		context.put("startTimeNanos", System.nanoTime());
+		context.put("traceId", traceId);
+		log.info("Request In [Servlet]: {} {}", context.getCarrier().getMethod(), context.getCarrier().getRequestURI());
+	}
+
+	@Override
+	public void onError(ServerRequestObservationContext context) {
+		long durationMillis = calculateDuration(context);
+		log.error("Request Out [Servlet] with Error: Status [{}], Cost [{}ms], Error [{}]",
+				getServletStatusCode(context), durationMillis, context.getError().getMessage(), context.getError());
+	}
+
+	/**
+	 * 【关键修正】onStop 依然是记录出参日志的最佳位置，因为它在 onScopeClosed 之前。
+	 * 之前的日志没有 traceId 很可能是因为时序的毫秒级竞争。
+	 * 但理论上 onStop 时 MDC 依然有效。
+	 */
+	@Override
+	public void onStop(ServerRequestObservationContext context) {
+		if (context.getError() == null) {
+			long durationMillis = calculateDuration(context);
+			log.info("Request Out [Servlet]: Status [{}], Cost [{}ms]",
+					getServletStatusCode(context), durationMillis);
+		}
+	}
+
+	private long calculateDuration(ServerRequestObservationContext context) {
+		Long startTimeNanos = context.get("startTimeNanos");
+		return (startTimeNanos != null) ? TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - startTimeNanos) : 0L;
+	}
+
+	private int getServletStatusCode(ServerRequestObservationContext context) {
+		HttpServletResponse response = context.getResponse();
+		return (response != null) ? response.getStatus() : 0;
+	}
+}
