<+><configuration>\r\n    <springProperty scope=\"context\" name=\"logstashHost\" source=\"logstash.host\" defaultValue=\"localhost\"/>\r\n    <springProperty scope=\"context\" name=\"logstashPort\" source=\"logstash.port\" defaultValue=\"4560\"/>\r\n    <contextName>${spring.application.name:-xksms-app}</contextName>\r\n\r\n    <!-- 公共转换规则 -->\r\n    <conversionRule conversionWord=\"ip\" converterClass=\"com.xksms.log.config.IpConfig\"/>\r\n    <conversionRule conversionWord=\"tid\" converterClass=\"org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternConverter\"/>\r\n\r\n    <!-- 控制台输出（开发使用） -->\r\n    <appender name=\"STDOUT\" class=\"ch.qos.logback.core.ConsoleAppender\">\r\n        <encoder class=\"net.logstash.logback.encoder.LogstashEncoder\">\r\n            <jsonGeneratorDecorator class=\"net.logstash.logback.decorate.PrettyPrintingJsonGeneratorDecorator\"/>\r\n            <timestamp>\r\n                <fieldName>timestamp</fieldName>\r\n                <timeZone>UTC</timeZone>\r\n            </timestamp>\r\n            <contextName>\r\n                <fieldName>app_name</fieldName>\r\n            </contextName>\r\n            <logLevel>\r\n                <fieldName>level</fieldName>\r\n            </logLevel>\r\n            <mdc>\r\n                <includeMdcKeyName>tid</includeMdcKeyName>\r\n            </mdc>\r\n            <pattern>\r\n                <omitEmptyFields>true</omitEmptyFields>\r\n                <pattern>{\"ip\": \"%ip\"}</pattern>\r\n            </pattern>\r\n            <threadName>\r\n                <fieldName>thread</fieldName>\r\n            </threadName>\r\n            <loggerName>\r\n                <fieldName>logger</fieldName>\r\n            </loggerName>\r\n            <message/>\r\n            <stackTrace>\r\n                <fieldName>stack_trace</fieldName>\r\n            </stackTrace>\r\n\r\n        </encoder>\r\n    </appender>\r\n\r\n    <!-- Logstash 输出（生产使用） -->\r\n    <appender name=\"LOGSTASH\" class=\"net.logstash.logback.appender.LogstashTcpSocketAppender\">\r\n        <destination>${logstashHost}:${logstashPort}</destination>\r\n        <keepAliveDuration>5 minutes</keepAliveDuration>\r\n        <reconnectionDelay>3 seconds</reconnectionDelay>\r\n        <encoder class=\"net.logstash.logback.encoder.LogstashEncoder\">\r\n            <timestamp>\r\n                <fieldName>timestamp</fieldName>\r\n                <timeZone>UTC</timeZone>\r\n            </timestamp>\r\n            <contextName>\r\n                <fieldName>app_name</fieldName>\r\n            </contextName>\r\n            <logLevel>\r\n                <fieldName>level</fieldName>\r\n            </logLevel>\r\n            <mdc>\r\n                <includeMdcKeyName>tid</includeMdcKeyName>\r\n            </mdc>\r\n            <pattern>\r\n                <omitEmptyFields>true</omitEmptyFields>\r\n                <pattern>{\"ip\": \"%ip\"}</pattern>\r\n            </pattern>\r\n            <threadName>\r\n                <fieldName>thread</fieldName>\r\n            </threadName>\r\n            <loggerName>\r\n                <fieldName>logger</fieldName>\r\n            </loggerName>\r\n            <message/>\r\n            <stackTrace>\r\n                <fieldName>stack_trace</fieldName>\r\n            </stackTrace>\r\n\r\n        </encoder>\r\n    </appender>\r\n\r\n    <!--    <root level=\"INFO\">-->\r\n    <!--        <appender-ref ref=\"STDOUT\"/>-->\r\n    <!--    </root>-->\r\n\r\n\r\n    <!-- 开发环境日志配置 -->\r\n    <springProfile name=\"dev\">\r\n        <root level=\"DEBUG\">\r\n            <appender-ref ref=\"STDOUT\"/>\r\n            <appender-ref ref=\"LOGSTASH\"/>\r\n        </root>\r\n        <logger name=\"com.xksms\" level=\"DEBUG\"/>\r\n\r\n        <logger name=\"org.springframework\" level=\"INFO\"/>\r\n        <logger name=\"org.apache.ibatis\" level=\"DEBUG\"/>\r\n\r\n        <logger name=\"com.alibaba.nacos\" level=\"INFO\"/>\r\n        <logger name=\"com.alibaba.cloud.nacos\" level=\"INFO\"/>\r\n\r\n        <logger name=\"io.netty\" level=\"INFO\"/>\r\n        <logger name=\"reactor.netty\" level=\"INFO\"/>\r\n\r\n        <logger name=\"org.springframework.cloud.gateway\" level=\"DEBUG\"/>\r\n    </springProfile>\r\n\r\n    <!-- 测试环境日志配置 -->\r\n    <springProfile name=\"test\">\r\n        <root level=\"INFO\">\r\n            <appender-ref ref=\"STDOUT\"/>\r\n            <appender-ref ref=\"LOGSTASH\"/>\r\n        </root>\r\n        <logger name=\"com.xksms\" level=\"INFO\"/>\r\n        <logger name=\"org.springframework\" level=\"INFO\"/>\r\n        <logger name=\"org.apache.ibatis\" level=\"INFO\"/>\r\n\r\n        <logger name=\"com.alibaba.nacos\" level=\"INFO\"/>\r\n        <logger name=\"com.alibaba.cloud.nacos\" level=\"INFO\"/>\r\n\r\n        <logger name=\"io.netty\" level=\"INFO\"/>\r\n        <logger name=\"reactor.netty\" level=\"INFO\"/>\r\n    </springProfile>\r\n\r\n    <!-- 生产环境日志配置 -->\r\n    <springProfile name=\"prod\">\r\n        <root level=\"INFO\">\r\n            <appender-ref ref=\"LOGSTASH\"/>\r\n        </root>\r\n\r\n        <logger name=\"com.xksms\" level=\"INFO\"/>\r\n        <logger name=\"org.springframework\" level=\"WARN\"/>\r\n        <logger name=\"org.apache.ibatis\" level=\"WARN\"/>\r\n\r\n        <logger name=\"com.alibaba.nacos\" level=\"WARN\"/>\r\n        <logger name=\"com.alibaba.cloud.nacos\" level=\"WARN\"/>\r\n\r\n        <logger name=\"io.netty\" level=\"WARN\"/>\r\n        <logger name=\"reactor.netty\" level=\"WARN\"/>\r\n    </springProfile>\r\n\r\n</configuration>\r\n
